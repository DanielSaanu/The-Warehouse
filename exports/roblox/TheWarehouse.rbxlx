      <Item class="ModuleScript" referent="RBX00000004">
        <Properties>
          <string name="Name">Sprites</string>
          <ProtectedString name="Source"><![CDATA[-- GENERATED by The Warehouse (warehouse roblox build). Do not edit by hand; edit scenes/ and rebuild.
local AssetService = game:GetService("AssetService")

local Sprites = {}

Sprites.Sheets = {
	[1] = { Id = "rbxassetid://0", Width = 64, Height = 64 },
}

Sprites.Sprites = {
	["floor_moss"] = { Sheet = 1, X = 1, Y = 1, W = 16, H = 16 },
	["rain_tile"] = { Sheet = 1, X = 18, Y = 1, W = 16, H = 16 },
	["scav_idle"] = { Sheet = 1, X = 35, Y = 1, W = 16, H = 16 },
	["scav_red"] = { Sheet = 1, X = 1, Y = 18, W = 16, H = 16 },
	["slug_idle"] = { Sheet = 1, X = 18, Y = 18, W = 16, H = 16 },
	["wall_stone"] = { Sheet = 1, X = 35, Y = 18, W = 16, H = 16 },
}

-- Embedded pixels (SheetData.lua next to this module) let the game run before anything is uploaded.
local sheetDataModule = script.Parent and script.Parent:FindFirstChild("SheetData")
local SheetData = if sheetDataModule then require(sheetDataModule) else nil
local editables = {}

local ALPHA = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local LOOKUP = {}
for i = 1, 64 do LOOKUP[string.byte(ALPHA, i)] = i - 1 end

--- Decode one embedded sheet into an RGBA8 buffer (pure Luau, no Roblox APIs).
function Sprites.DecodePixels(data)
	local w, h = data.Width, data.Height
	local buf = buffer.create(w * h * 4)
	local pal, runs = data.Palette, data.Runs
	local pos = 0
	for i = 1, #runs, 3 do
		local a, b, c = string.byte(runs, i, i + 2)
		local color = pal[LOOKUP[a] * 64 + LOOKUP[b] + 1]
		local r, g, bl, al = color[1], color[2], color[3], color[4]
		for _ = 1, LOOKUP[c] + 1 do
			buffer.writeu8(buf, pos, r)
			buffer.writeu8(buf, pos + 1, g)
			buffer.writeu8(buf, pos + 2, bl)
			buffer.writeu8(buf, pos + 3, al)
			pos += 4
		end
	end
	return buf, w, h
end

local function editableFor(sheetIndex)
	if editables[sheetIndex] ~= nil then return editables[sheetIndex] or nil end
	local data = SheetData and SheetData[sheetIndex]
	if not data then editables[sheetIndex] = false return nil end
	local ok, result = pcall(function()
		local buf, w, h = Sprites.DecodePixels(data)
		local img = AssetService:CreateEditableImage({ Size = Vector2.new(w, h) })
		img:WritePixelsBuffer(Vector2.zero, Vector2.new(w, h), buf)
		return img
	end)
	if not ok then warn("[Sprites] could not build embedded sheet " .. sheetIndex .. ": " .. tostring(result)) editables[sheetIndex] = false return nil end
	editables[sheetIndex] = result
	return result
end

function Sprites.HasEmbedded(sheetIndex: number?): boolean
	return SheetData ~= nil and SheetData[sheetIndex or 1] ~= nil
end

--- Point an ImageLabel/ImageButton at a named sprite. Keeps pixels crisp.
function Sprites.Apply(image: ImageLabel | ImageButton, spriteName: string)
	local s = Sprites.Sprites[spriteName]
	if not s then warn("[Sprites] unknown sprite " .. tostring(spriteName)) return end
	local sheet = Sprites.Sheets[s.Sheet]
	if sheet.Id ~= "rbxassetid://0" then
		image.Image = sheet.Id
	else
		local editable = editableFor(s.Sheet)
		if editable then
			image.ImageContent = Content.fromObject(editable)
		else
			warn("[Sprites] sheet " .. s.Sheet .. " has no asset id and no embedded pixels. Run: warehouse roblox build")
		end
	end
	image.ImageRectOffset = Vector2.new(s.X, s.Y)
	image.ImageRectSize = Vector2.new(s.W, s.H)
	image.ResampleMode = Enum.ResamplerMode.Pixelated
	image.ScaleType = Enum.ScaleType.Stretch
end

--- Create a new ImageLabel showing a sprite.
function Sprites.New(spriteName: string, parent: Instance?): ImageLabel
	local img = Instance.new("ImageLabel")
	img.BackgroundTransparency = 1
	img.BorderSizePixel = 0
	img.Name = spriteName
	Sprites.Apply(img, spriteName)
	if parent then img.Parent = parent end
	return img
end

function Sprites.Has(spriteName: string): boolean return Sprites.Sprites[spriteName] ~= nil end

return Sprites
]]></ProtectedString>
        </Properties>
      </Item>
