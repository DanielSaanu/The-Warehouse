# Copy to .env and fill in. Never commit .env.
# Roblox Open Cloud key with Assets read+write. See docs/ROBLOX_SETUP.md
ROBLOX_API_KEY=
# Your Roblox user id (numbers in your profile URL) OR a group id you own
ROBLOX_CREATOR_USER_ID=
ROBLOX_CREATOR_GROUP_ID=
# Optional: poly.pizza key for 3D search
POLY_PIZZA_KEY=
# Optional: port for the UI
WAREHOUSE_PORT=4242
